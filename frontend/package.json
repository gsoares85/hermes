{
  "name": "hermes-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run clean && tsc --noEmit && vite build",
    "build:dev": "npm run clean && tsc --noEmit && vite build --mode development --minify false",
    "clean": "node -e \"const fs=require('fs');for(const e of fs.readdirSync('dist')){if(e!=='.gitkeep')fs.rmSync('dist/'+e,{recursive:true,force:true})}\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint . && prettier --check src",
    "format": "prettier --write src"
  },
  "dependencies": {
    "@fontsource/inter": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@tanstack/react-virtual": "3.14.13",
    "@wailsio/runtime": "3.0.0-beta.16",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "^26.6.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "eslint": "10.11.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "happy-dom": "20.14.5",
    "prettier": "3.9.9",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.1",
    "vite": "8.3.1",
    "vitest": "^5.0.1"
  },
  "overrides": {
    "rolldown": "1.2.7"
  }
}
